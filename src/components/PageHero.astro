---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  image: string;
  imageAlt: string;
}

const { eyebrow, title, description, image, imageAlt } = Astro.props;
---

<section class="relative bg-ink-strong overflow-hidden pt-32 pb-20 lg:pt-40 lg:pb-28">
  <div class="absolute inset-0">
    <div class="absolute inset-0 bg-gradient-to-r from-black/75 via-black/55 to-black/35 z-10"></div>
    <img src={image} alt={imageAlt} class="absolute inset-0 w-full h-full object-cover" loading="eager" />
  </div>

  <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <p class="text-accent text-xs sm:text-sm font-semibold tracking-widest uppercase mb-4">
        {eyebrow}
      </p>
      <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl text-on-dark leading-[1.1] tracking-tight mb-6">
        {title}
      </h1>
      <p class="text-on-dark/80 text-lg leading-relaxed mb-8 max-w-xl">
        {description}
      </p>
      <div class="flex flex-col sm:flex-row gap-4">
        <a href="#contact" data-gtag-event="cta_click" data-gtag-label={`PageHero - ${title}`} class="inline-flex items-center justify-center bg-accent text-white font-extrabold text-base px-8 py-4 rounded-default hover:bg-accent-dark transition-colors border-2 border-accent hover:border-accent-dark">
          Request a Free Estimate
        </a>
        <a href="tel:+14014865587" class="inline-flex items-center justify-center bg-transparent text-white font-bold text-base px-8 py-4 rounded-default border-2 border-white/50 hover:border-white hover:bg-white/10 transition-all">
          Call Now: (401) 486-5587
        </a>
      </div>
    </div>
  </div>
</section>
