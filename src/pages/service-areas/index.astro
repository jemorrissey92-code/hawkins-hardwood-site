---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import Contact from '../../components/Contact.astro';

const coreMarkets = [
  { name: 'Providence, RI', href: '/service-areas/providence/', hasPage: true },
  { name: 'Cranston, RI', href: '/service-areas/cranston/', hasPage: true },
  { name: 'Warwick, RI', href: '/service-areas/warwick/', hasPage: true },
  { name: 'Smithfield, RI', href: '/service-areas/', hasPage: false },
  { name: 'Pawtucket, RI', href: '/service-areas/', hasPage: false },
  { name: 'East Greenwich, RI', href: '/service-areas/', hasPage: false },
  { name: 'North Kingstown, RI', href: '/service-areas/', hasPage: false },
];

const additionalAreas = [
  'Cumberland, RI', 'Barrington, RI', 'Bristol, RI', 'Narragansett, RI', 'Westerly, RI',
  'Attleboro, MA', 'North Attleboro, MA', 'Seekonk, MA',
];

const relatedLinks = [
  { title: 'Hardwood Floor Refinishing', description: 'Dustless sanding, custom stain, and durable finishes for worn hardwood.', href: '/services/refinishing/' },
  { title: 'Dustless Floor Sanding', description: 'A cleaner sanding process that captures 99% of airborne dust.', href: '/services/dustless-sanding/' },
  { title: 'Hardwood Floor Installation', description: 'New solid and engineered hardwood, installed with precise layout and prep.', href: '/services/installation/' },
];
---

<Layout
  title="Hardwood Flooring Service Areas | Rhode Island & Southeastern Massachusetts"
  description="Hawkins Hardwood Flooring serves Providence, Cranston, Warwick, Smithfield, Pawtucket, East Greenwich, North Kingstown, and Southeastern Massachusetts communities."
>
  <Header />
  <main>
    <Breadcrumbs crumbs={[{ label: 'Home', href: '/' }, { label: 'Service Areas', href: '/service-areas/' }]} />

    <section class="relative bg-ink-strong overflow-hidden pt-32 pb-20 lg:pt-40 lg:pb-28">
      <div class="absolute inset-0">
        <div class="absolute inset-0 bg-gradient-to-r from-black/75 via-black/55 to-black/35 z-10"></div>
        <img src="/images/hero.jpg" alt="Hardwood flooring project in a Rhode Island home" class="absolute inset-0 w-full h-full object-cover" loading="eager" />
      </div>
      <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-2xl">
          <p class="text-accent text-xs sm:text-sm font-semibold tracking-widest uppercase mb-4">Service Areas</p>
          <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl text-on-dark leading-[1.1] tracking-tight mb-6">
            Hardwood Flooring Service Areas in Rhode Island & Southeastern Massachusetts
          </h1>
          <p class="text-on-dark/80 text-lg leading-relaxed mb-8 max-w-xl">
            Based in Smithfield, we bring dustless sanding, refinishing, installation, repairs, and custom stain matching to homeowners across the region.
          </p>
          <a href="#contact" data-gtag-event="cta_click" data-gtag-label="Service Areas Hero" class="inline-flex items-center justify-center bg-accent text-white font-extrabold text-base px-8 py-4 rounded-default hover:bg-accent-dark transition-colors border-2 border-accent hover:border-accent-dark">
            Check Your Area
          </a>
        </div>
      </div>
    </section>

    <section class="py-20 lg:py-28 bg-surface">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="font-display text-2xl sm:text-3xl text-ink-strong leading-tight mb-6">
          Core Service Markets
        </h2>
        <p class="text-muted text-lg leading-relaxed mb-10">
          We do our most concentrated work in these communities. Select a city below for local project details, or contact us directly — we're happy to confirm whether your town is in our service area.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-16">
          {coreMarkets.map((market) => (
            market.hasPage ? (
              <a href={market.href} class="flex items-center justify-between bg-surface-warm rounded-default border border-border px-6 py-4 hover:border-accent hover:shadow-md transition-all group">
                <span class="font-semibold text-ink-strong">{market.name}</span>
                <svg class="w-4 h-4 text-accent group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
              </a>
            ) : (
              <div class="flex items-center justify-between bg-surface-warm rounded-default border border-border px-6 py-4">
                <span class="font-semibold text-ink-strong">{market.name}</span>
                <svg class="w-4 h-4 text-success" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" /></svg>
              </div>
            )
          ))}
        </div>

        <h3 class="font-display text-xl text-ink-strong mb-4">Also Serving</h3>
        <div class="flex flex-wrap gap-2 mb-10">
          {additionalAreas.map((area) => (
            <span class="inline-flex items-center gap-1.5 text-sm bg-white text-ink px-4 py-2 rounded-full border border-border font-medium">
              <svg class="w-3.5 h-3.5 text-accent" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" /></svg>
              {area}
            </span>
          ))}
        </div>

        <p class="text-muted text-base leading-relaxed">
          Don't see your town listed? Reach out anyway — we regularly take on projects just outside our core markets. Call <a href="tel:+14014865587" class="text-accent font-semibold hover:text-accent-dark">(401) 486-5587</a> or request a free estimate below.
        </p>
      </div>
    </section>

    <RelatedLinks links={relatedLinks} eyebrow="Our Services" heading="What We Do" />

    <Contact />
  </main>
  <Footer />
</Layout>
